# Optional. Leave unset to send API calls to the same origin the app is served
# from: `npm run dev` proxies /api to VITE_DEV_API_TARGET (default
# http://127.0.0.1:8000), and in production the frontend and backend share one
# origin. Set it only when the backend lives elsewhere.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Where the Vite dev server forwards /api requests (default http://127.0.0.1:8000).
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
